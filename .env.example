# Application
APP_NAME=smart-recommendation-api
APP_ENV=development
DEBUG=true

# Database
# Local: postgresql://postgres:postgres@localhost:5432/smart_recommendation
# Docker Compose: DATABASE_URL is overridden in docker-compose.yml — no change needed here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_recommendation

# Security
SECRET_KEY=change-me-in-production

# ML model persistence
# Directory where trained model artifacts (.joblib) are stored
MODEL_DIR=models

# Background jobs
# Interval (in hours) between automatic model retraining runs.
# Set to 0 to disable automatic retraining (POST /api/v1/admin/retrain still works).
RETRAIN_INTERVAL_HOURS=6

# CORS
# Comma-separated list of origins allowed to call the API.
# Development: Angular dev server runs on 4200 by default (ng serve).
# Production: replace with the deployed frontend URL, e.g. https://myapp.com
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
