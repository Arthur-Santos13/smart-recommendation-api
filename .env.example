# Application
APP_NAME=smart-recommendation-api
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_recommendation

# Security
SECRET_KEY=change-me-in-production

# ML model persistence
# Directory where trained model artifacts (.joblib) are stored
MODEL_DIR=models

# Background jobs
# Interval (in hours) between automatic model retraining runs.
# Set to 0 to disable automatic retraining (POST /api/v1/admin/retrain still works).
RETRAIN_INTERVAL_HOURS=6
